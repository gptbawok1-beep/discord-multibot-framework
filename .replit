modules = ["nodejs-20", "web", "bash"]

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["pnpm", "store", "prune"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Discord Bot 1"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Discord Bot 2"

[[workflows.workflow]]
name = "Discord Bot 1"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd discord-framework && npm install --silent && node bots/bot1/index.js"

[workflows.workflow.metadata]
outputType = "console"

[[workflows.workflow]]
name = "Discord Bot 2"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd discord-framework && npm install --silent && node bots/bot2/index.js"

[workflows.workflow.metadata]
outputType = "console"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
BOT1_CLIENT_ID = "1532306835132911696"
