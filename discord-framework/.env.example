# ============================================================
# Discord Multi-Bot Framework — Environment Variables
# Copy this file to .env and fill in your values.
# ============================================================

# Bot 1
BOT1_TOKEN=your_bot1_token_here
BOT1_CLIENT_ID=your_bot1_client_id_here
BOT1_PREFIX=!

# Bot 2
BOT2_TOKEN=your_bot2_token_here
BOT2_CLIENT_ID=your_bot2_client_id_here
BOT2_PREFIX=?

# General
NODE_ENV=development

# Log level: DEBUG | INFO | WARN | ERROR  (default: INFO)
LOG_LEVEL=INFO

# ── Color control ────────────────────────────────────────────
# Colors are auto-detected. Override if needed:
#
#   Force colors ON  (useful in Railway, Pterodactyl, or CI):
#   FORCE_COLOR=1
#
#   Force colors OFF (useful in Windows CMD or plain log files):
#   NO_COLOR=1
# ─────────────────────────────────────────────────────────────
